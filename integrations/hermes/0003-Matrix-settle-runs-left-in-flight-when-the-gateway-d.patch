From 1793014d2e29524cf3b2ab5fbfd5d437d1b0760e Mon Sep 17 00:00:00 2001
From: phrac <derek@disflux.com>
Date: Sun, 11 Oct 2026 15:18:19 -0500
Subject: [PATCH] Matrix: settle runs left in flight when the gateway dies
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A gateway killed mid-run never reaches on_processing_complete, so its
pointing-eye reaction stays on the request and its agent-protocol status
bubble stays state=working on the wire forever — clients show the run as
running until their own stall sweep, and the reaction is unrecoverable
to a client that never saw the request.

The adapter now persists in-flight runs (eyes event ids + working
bubbles) to in_flight_runs.json in its store dir on every change, and
on the next connect redacts the leftover eyes and edits the leftover
bubbles to failed with a result of 'interrupted by a gateway restart'.
Crash-safe: a re-settle after a crash between write and clear is a
no-op on both signals.
---
 plugins/platforms/matrix/adapter.py           | 91 ++++++++++++++++++-
 .../test_matrix_settle_orphaned_runs.py       | 85 +++++++++++++++++
 2 files changed, 172 insertions(+), 4 deletions(-)
 create mode 100644 tests/gateway/test_matrix_settle_orphaned_runs.py

diff --git a/plugins/platforms/matrix/adapter.py b/plugins/platforms/matrix/adapter.py
index 4111699935..b49300709a 100644
--- a/plugins/platforms/matrix/adapter.py
+++ b/plugins/platforms/matrix/adapter.py
@@ -826,6 +826,12 @@ class MatrixAdapter(BasePlatformAdapter):
     def _crypto_db_path(self) -> Path:
         return (self._store_dir or _get_hermes_dir("platforms/matrix/store", "matrix/store")) / "crypto.db"
 
+    @property
+    def _run_state_path(self) -> Path:
+        """In-flight run state (👀 + status bubble), resolved like the crypto store: connect()
+        pins the profile dir, out-of-scope reads fall back to the default one."""
+        return (self._store_dir or _get_hermes_dir("platforms/matrix/store", "matrix/store")) / "in_flight_runs.json"
+
     def __init__(self, config: PlatformConfig):
         super().__init__(config, Platform.MATRIX)
         self.max_message_length = _resolve_max_message_length(config)
@@ -1364,6 +1370,8 @@ class MatrixAdapter(BasePlatformAdapter):
         self._sync_task = asyncio.create_task(self._sync_loop())
         self._mark_connected()
         self._wire_plugin_handlers(self._client)  # plugin-registered native handlers
+        with suppress(Exception):  # best effort: a failed cleanup must not fail the connect
+            await self._settle_orphaned_runs()
         return True
 
     async def disconnect(self) -> None:
@@ -1429,8 +1437,80 @@ class MatrixAdapter(BasePlatformAdapter):
         if (not event_id or not isinstance(status, dict) or status.get("state") != "working"
                 or not status.get("run") or status.get("choices")):  # a settled prompt isn't the bubble
             return
-        bubbles = self.__dict__.setdefault("_agent_status_bubbles", {})
-        bubbles[(chat_id, str(status["run"]))] = (str(event_id), text)
+        self._agent_status_bubbles[(chat_id, str(status["run"]))] = (str(event_id), text)
+        self._save_in_flight_runs()
+
+    def _load_in_flight_runs(self) -> dict[tuple[str, str], tuple[str, str]]:
+        """The status bubbles in flight when the gateway last died, keyed by (room, run).
+        (👀 event ids are recovered separately: see _settle_orphaned_runs.)"""
+        try:
+            raw = json.loads(self._run_state_path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return {}
+        except Exception as exc:
+            logger.debug("Matrix: could not read in-flight run state: %s", exc)
+            return {}
+        if not isinstance(raw, dict) or not isinstance(raw.get("bubbles"), dict):
+            return {}
+        out = {}
+        for key, bubble in raw["bubbles"].items():
+            parts = str(key).split("\x1f", 1)
+            if len(parts) == 2 and isinstance(bubble, list) and len(bubble) == 2:
+                out[(parts[0], parts[1])] = (str(bubble[0]), str(bubble[1]))
+        return out
+
+    def _save_in_flight_runs(self) -> None:
+        """Persist the runs still in flight (their 👀 event ids and working bubbles), so a
+        restart can settle them instead of leaving dead runs showing as working on the wire
+        forever. A crash between write and settle re-settles harmlessly: redacting a gone
+        reaction and re-editing a settled bubble are both no-ops."""
+        state = {
+            "runs": [f"{room}\x1f{run}" for room, run in sorted(self._pending_reactions)],
+            "eyes": {f"{room}\x1f{run}": ev for (room, run), ev in self._pending_reactions.items()},
+            "bubbles": {f"{room}\x1f{run}": list(b) for (room, run), b in self._agent_status_bubbles.items()},
+        }
+        try:
+            path = self._run_state_path
+            path.parent.mkdir(parents=True, exist_ok=True)
+            tmp = path.with_suffix(".json.tmp")
+            tmp.write_text(json.dumps(state), encoding="utf-8")
+            tmp.replace(path)
+        except Exception as exc:
+            logger.debug("Matrix: could not save in-flight run state: %s", exc)
+
+    async def _settle_orphaned_runs(self) -> None:
+        """A gateway killed mid-run never reached on_processing_complete: its 👀 is still on
+        the request and its status bubble still says working. On connect, take both back."""
+        try:
+            raw = json.loads(self._run_state_path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return
+        except Exception as exc:
+            logger.debug("Matrix: could not read in-flight run state: %s", exc)
+            return
+        if not isinstance(raw, dict) or not raw.get("runs"):
+            return
+        eyes_map, bubbles = raw.get("eyes") or {}, self._load_in_flight_runs()
+        settled = 0
+        for key in raw.get("runs", []):
+            room, _, run = str(key).partition("\x1f")
+            if not room or not run:
+                continue
+            eyes_event_id = self._pending_reactions.pop((room, run), None) or eyes_map.get(key)
+            if eyes_event_id:
+                await self._redact_reaction(room, eyes_event_id, "gateway restarted mid-run")
+                settled += 1
+            bubble = self._agent_status_bubbles.pop((room, run), None) or bubbles.get((room, run))
+            if bubble:
+                status = {"v": 1, "run": run, "state": "failed", "result": "interrupted by a gateway restart"}
+                with suppress(Exception):
+                    await self.edit_message(room, bubble[0], bubble[1], agent_status=status)
+                settled += 1
+        self._pending_reactions.clear()
+        self._agent_status_bubbles.clear()
+        self._save_in_flight_runs()
+        if settled:
+            logger.info("Matrix: settled %d run signal(s) left over from before the restart", settled)
 
     async def _settle_status_bubble(self, event: MessageEvent, outcome: ProcessingOutcome) -> None:
         """Agent protocol: edit the run's working message to how the run ended."""
@@ -1511,8 +1591,8 @@ class MatrixAdapter(BasePlatformAdapter):
         await self._set_typing(chat_id, 0)
 
     async def edit_message(self, chat_id: str, message_id: str, content: str, *, finalize: bool = False,
-                           agent_status: Optional[Dict[str, Any]] = None,
-                           metadata: Optional[Dict[str, Any]] = None) -> SendResult:
+                           agent_status: Optional[dict[str, Any]] = None,
+                           metadata: Optional[dict[str, Any]] = None) -> SendResult:
         if agent_status is None and isinstance((metadata or {}).get("fluxchat_agent"), dict):
             agent_status = metadata["fluxchat_agent"]
         formatted = self.format_message(content)
@@ -2534,14 +2614,17 @@ class MatrixAdapter(BasePlatformAdapter):
             reaction_event_id = await self._send_reaction(room_id, msg_id, "\U0001f440")
             if reaction_event_id:
                 self._pending_reactions[(room_id, msg_id)] = reaction_event_id
+                self._save_in_flight_runs()
 
     async def on_processing_complete(self, event: MessageEvent, outcome: ProcessingOutcome) -> None:
         msg_id, room_id = event.message_id, event.source.chat_id
         await self._settle_status_bubble(event, outcome)
+        self._save_in_flight_runs()  # the bubble settled; drop the run from the restart file
         if not self._reactions_enabled or not msg_id or not room_id or outcome == ProcessingOutcome.CANCELLED:
             return
         eyes_event_id = self._pending_reactions.pop((room_id, msg_id), None)
         if eyes_event_id:
+            self._save_in_flight_runs()
             self._schedule_reaction_redaction(room_id, eyes_event_id, "processing complete")
         await self._send_reaction(room_id, msg_id, "\u2705" if outcome == ProcessingOutcome.SUCCESS else "\u274c")
 
diff --git a/tests/gateway/test_matrix_settle_orphaned_runs.py b/tests/gateway/test_matrix_settle_orphaned_runs.py
new file mode 100644
index 0000000000..2f93ea65fc
--- /dev/null
+++ b/tests/gateway/test_matrix_settle_orphaned_runs.py
@@ -0,0 +1,85 @@
+"""Matrix adapter: a gateway restart settles the runs it left in flight.
+
+A gateway killed mid-run never reaches on_processing_complete, so its 👀 stays
+on the request and its agent-protocol status bubble stays "working" on the wire
+forever — clients show the run as running until their own stall sweep. The
+adapter persists in-flight runs to its store dir and, on the next connect,
+redacts the 👀s and edits the bubbles to failed.
+"""
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from gateway.config import PlatformConfig
+
+KEY = "org.fluxchat.agent"
+ROOM = "!r:example.org"
+
+
+def _adapter(monkeypatch, tmp_path):
+    monkeypatch.setenv("MATRIX_ALLOWED_USERS", "@me:example.org")
+    from plugins.platforms.matrix.adapter import MatrixAdapter
+    adapter = MatrixAdapter(PlatformConfig(enabled=True, token="tok", extra={"homeserver": "https://matrix.example.org"}))
+    adapter._user_id = "@bot:example.org"
+    adapter._client = object()
+    monkeypatch.setattr(type(adapter), "_run_state_path", property(lambda self: tmp_path / "in_flight_runs.json"))
+    return adapter
+
+
+def _event(msg_id="$req"):
+    return SimpleNamespace(message_id=msg_id, source=SimpleNamespace(chat_id=ROOM))
+
+
+def _state(tmp_path):
+    return json.loads((tmp_path / "in_flight_runs.json").read_text())
+
+
+@pytest.mark.asyncio
+async def test_in_flight_runs_are_written_and_cleared_around_a_run(monkeypatch, tmp_path):
+    from gateway.platforms.base import ProcessingOutcome
+    adapter = _adapter(monkeypatch, tmp_path)
+    adapter._send_reaction = AsyncMock(return_value="$eyes")
+    await adapter.on_processing_start(_event())
+    state = _state(tmp_path)
+    assert state["runs"] == [f"{ROOM}\x1f$req"]
+    assert state["eyes"] == {f"{ROOM}\x1f$req": "$eyes"}
+    # A working bubble joins the same run's entry.
+    adapter._remember_status_bubble(ROOM, "$prog", "📖 Reading", {"state": "working", "run": "$req"})
+    assert _state(tmp_path)["bubbles"] == {f"{ROOM}\x1f$req": ["$prog", "📖 Reading"]}
+    # A clean end empties it.
+    adapter._redact_reaction = AsyncMock(return_value=True)
+    adapter.edit_message = AsyncMock()
+    await adapter.on_processing_complete(_event(), ProcessingOutcome.SUCCESS)
+    assert _state(tmp_path)["runs"] == []
+
+
+@pytest.mark.asyncio
+async def test_connect_settles_runs_left_over_from_the_last_process(monkeypatch, tmp_path):
+    adapter = _adapter(monkeypatch, tmp_path)  # fresh process: the maps start empty
+    (tmp_path / "in_flight_runs.json").write_text(json.dumps({
+        "runs": [f"{ROOM}\x1f$dead"],
+        "eyes": {f"{ROOM}\x1f$dead": "$eyes-old"},
+        "bubbles": {f"{ROOM}\x1f$dead": ["$prog-old", "📖 Reading"]},
+    }))
+    adapter._redact_reaction = AsyncMock(return_value=True)
+    adapter.edit_message = AsyncMock()
+    await adapter._settle_orphaned_runs()
+    adapter._redact_reaction.assert_awaited_once_with(ROOM, "$eyes-old", "gateway restarted mid-run")
+    room, ev, text = adapter.edit_message.await_args.args
+    status = adapter.edit_message.await_args.kwargs["agent_status"]
+    assert (room, ev, text) == (ROOM, "$prog-old", "📖 Reading")
+    assert status["state"] == "failed" and status["run"] == "$dead"
+    assert KEY not in status  # the edit carries the status via the agent_status kwarg
+    # Settled: the file has nothing left, and a second pass is a no-op.
+    assert _state(tmp_path)["runs"] == []
+    await adapter._settle_orphaned_runs()
+    assert adapter.edit_message.await_count == 1
+
+
+@pytest.mark.asyncio
+async def test_a_missing_or_broken_file_is_not_an_error(monkeypatch, tmp_path):
+    adapter = _adapter(monkeypatch, tmp_path)
+    await adapter._settle_orphaned_runs()  # no file at all
+    (tmp_path / "in_flight_runs.json").write_text("{not json")
+    await adapter._settle_orphaned_runs()  # garbage is treated as empty
-- 
