From 5267f87a00244835aac0df32d26e440e813c1ab5 Mon Sep 17 00:00:00 2001
From: phrac <derek@disflux.com>
Date: Mon, 12 Oct 2026 10:51:52 -0500
Subject: [PATCH] Matrix: settle the first working bubble, not the last tracked
 send

_remember_status_bubble overwrote the tracked (room, run) bubble with every
new working send, so a later step log or heartbeat moved the settle target
off the real bubble; the run-end edit then settled the progress message and
the original working bubble stayed state=working on the wire forever
(The Battlefront repro, 2026-10-12, triggered by the queued-follow-up
'deliver first response' path).

Track only the FIRST working message per (room, run); later working sends
are progress. Edits of the tracked bubble itself still refresh its
remembered text so a restart settles it with the latest progress.
---
 plugins/platforms/matrix/adapter.py           | 17 +++++++-
 .../test_matrix_settle_orphaned_runs.py       | 39 +++++++++++++++++++
 2 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/plugins/platforms/matrix/adapter.py b/plugins/platforms/matrix/adapter.py
index b49300709a..e7c0570fbe 100644
--- a/plugins/platforms/matrix/adapter.py
+++ b/plugins/platforms/matrix/adapter.py
@@ -1433,11 +1433,24 @@ class MatrixAdapter(BasePlatformAdapter):
         return SendResult(success=True, message_id=last_event_id)
 
     def _remember_status_bubble(self, chat_id: str, event_id: Optional[str], text: str, status: Any) -> None:
-        """Agent protocol: track the run's working message, to settle it when the run ends."""
+        """Agent protocol: track the run's working message, to settle it when the run ends.
+
+        Only the FIRST working message of a run is the bubble. Later working sends (step
+        logs, heartbeats) are progress: re-tracking them moved the settle target off the
+        bubble, which then stayed ``state=working`` on the wire forever (The Battlefront
+        repro, 2026-10-12). An edit of the tracked bubble itself still refreshes its
+        remembered text, so a restart settles it with the latest progress.
+        """
         if (not event_id or not isinstance(status, dict) or status.get("state") != "working"
                 or not status.get("run") or status.get("choices")):  # a settled prompt isn't the bubble
             return
-        self._agent_status_bubbles[(chat_id, str(status["run"]))] = (str(event_id), text)
+        key = (chat_id, str(status["run"]))
+        if (existing := self._agent_status_bubbles.get(key)) is not None:
+            if existing[0] != str(event_id):
+                return  # a later working send is progress, not the bubble
+            if existing[1] == text:
+                return  # re-editing the same text: nothing new to persist
+        self._agent_status_bubbles[key] = (str(event_id), text)
         self._save_in_flight_runs()
 
     def _load_in_flight_runs(self) -> dict[tuple[str, str], tuple[str, str]]:
diff --git a/tests/gateway/test_matrix_settle_orphaned_runs.py b/tests/gateway/test_matrix_settle_orphaned_runs.py
index 2f93ea65fc..6068f4ee1a 100644
--- a/tests/gateway/test_matrix_settle_orphaned_runs.py
+++ b/tests/gateway/test_matrix_settle_orphaned_runs.py
@@ -83,3 +83,42 @@ async def test_a_missing_or_broken_file_is_not_an_error(monkeypatch, tmp_path):
     await adapter._settle_orphaned_runs()  # no file at all
     (tmp_path / "in_flight_runs.json").write_text("{not json")
     await adapter._settle_orphaned_runs()  # garbage is treated as empty
+
+
+@pytest.mark.asyncio
+async def test_only_the_first_working_message_of_a_run_is_the_bubble(monkeypatch, tmp_path):
+    """The settle target must not move to a later working send (step log, heartbeat).
+
+    Repro (The Battlefront, 2026-10-12): the queued-follow-up path sent progress working
+    messages after the real bubble; the run-end edit chased the last tracked event, so the
+    original working bubble stayed state=working on the wire forever.
+    """
+    from gateway.platforms.base import ProcessingOutcome
+    adapter = _adapter(monkeypatch, tmp_path)
+    run = "$req"
+    adapter._remember_status_bubble(ROOM, "$bubble", "📖 Reading", {"state": "working", "run": run})
+    # Later working SENDS (new events) are progress: they must not steal the settle target.
+    adapter._remember_status_bubble(ROOM, "$step-log", "🔧 Running tool", {"state": "working", "run": run})
+    adapter._remember_status_bubble(ROOM, "$heartbeat", "💓 still working", {"state": "working", "run": run})
+    assert adapter._agent_status_bubbles[(ROOM, run)] == ("$bubble", "📖 Reading")
+    assert _state(tmp_path)["bubbles"] == {f"{ROOM}\x1f{run}": ["$bubble", "📖 Reading"]}
+    # An EDIT of the bubble itself keeps the same target and refreshes the remembered text.
+    adapter._remember_status_bubble(ROOM, "$bubble", "📖 Reading + 🔧 Running tool", {"state": "working", "run": run})
+    assert adapter._agent_status_bubbles[(ROOM, run)] == ("$bubble", "📖 Reading + 🔧 Running tool")
+    assert _state(tmp_path)["bubbles"] == {f"{ROOM}\x1f{run}": ["$bubble", "📖 Reading + 🔧 Running tool"]}
+    # The run ends: the FIRST working bubble is what gets settled.
+    adapter._redact_reaction = AsyncMock(return_value=True)
+    adapter.edit_message = AsyncMock()
+    await adapter.on_processing_complete(_event(msg_id=run), ProcessingOutcome.SUCCESS)
+    assert adapter.edit_message.await_args.args[1] == "$bubble"
+    assert adapter.edit_message.await_args.kwargs["agent_status"]["state"] == "done"
+
+
+@pytest.mark.asyncio
+async def test_a_working_status_without_a_run_is_never_tracked(monkeypatch, tmp_path):
+    adapter = _adapter(monkeypatch, tmp_path)
+    adapter._remember_status_bubble(ROOM, "$x", "hi", {"state": "working"})
+    adapter._remember_status_bubble(ROOM, "$y", "hi", {"state": "done", "run": "$req"})
+    adapter._remember_status_bubble(  # a settled approval prompt isn't the bubble either
+        ROOM, "$z", "ok", {"state": "working", "run": "$req", "choices": [{"label": "Allow"}]})
+    assert adapter._agent_status_bubbles == {}
