From 5a867baa2c7c5965887b21a2961947c2620a2e06 Mon Sep 17 00:00:00 2001
From: Derek Musselmann <derek@disflux.com>
Date: Sun, 4 Oct 2026 20:50:59 -0500
Subject: [PATCH] Matrix: agent protocol status on exec approvals
 (org.fluxchat.agent)

Approval prompts carry their choices (labelled like the prompt's own
actions) and state "waiting" in org.fluxchat.agent, and are edited to
"working" once resolved or expired, so clients that read the protocol
can show buttons and drop them when settled. send() takes the fields from
metadata["fluxchat_agent"]; edit_message() from agent_status=. Nothing
changes for clients that don't read the key.
---
 plugins/platforms/matrix/adapter.py         | 40 +++++++++++-
 tests/gateway/test_matrix_agent_protocol.py | 71 +++++++++++++++++++++
 2 files changed, 108 insertions(+), 3 deletions(-)
 create mode 100644 tests/gateway/test_matrix_agent_protocol.py

diff --git a/plugins/platforms/matrix/adapter.py b/plugins/platforms/matrix/adapter.py
index 1a288fb0..9fd32932 100644
--- a/plugins/platforms/matrix/adapter.py
+++ b/plugins/platforms/matrix/adapter.py
@@ -127,6 +127,12 @@ def _matrix_voice_metadata_for_file(path: Path) -> Dict[str, Any]:
             logger.debug("Matrix: failed to build voice waveform for %s", path, exc_info=True)
     return metadata
 
+# Agent protocol (https://github.com/phrac/fluxchat/blob/main/docs/agent-protocol.md): run state and
+# prompt choices in message content, so clients can show buttons instead of decoding reactions.
+# Callers opt in by putting a ``fluxchat_agent`` dict in ``metadata``.
+_AGENT_STATUS_KEY = "org.fluxchat.agent"
+
+
 _MATRIX_BANG_COMMAND_RE = re.compile(r"^!([A-Za-z][A-Za-z0-9_-]*)(?=$|\s)(.*)$", re.DOTALL)
 
 
@@ -351,6 +357,9 @@ class _MatrixApprovalPrompt:
     resolved: bool = False
     requester_user_id: str | None = None
     expires_at: float | None = None
+    # Prompt text and its agent-protocol choices, to edit it out of "waiting" once settled.
+    text: str = ""
+    agent_choices: list = field(default_factory=list)
     bot_reaction_events: dict[str, str] = field(default_factory=dict, init=False)  # emoji -> event_id
 
 
@@ -1429,6 +1438,9 @@ class MatrixAdapter(BasePlatformAdapter):
                 self.format_message(content), self.max_message_length, len_fn=self.message_len_fn):
             msg_content = self._build_text_message_content(chunk)
             self._apply_relation_metadata(msg_content, reply_to=reply_to, metadata=metadata)
+            agent_status = (metadata or {}).get("fluxchat_agent")
+            if isinstance(agent_status, dict):
+                msg_content[_AGENT_STATUS_KEY] = agent_status
             try:
                 last_event_id = await self._send_room_message(chat_id, msg_content)
                 logger.info("Matrix: sent event %s to %s", last_event_id, chat_id)
@@ -1509,9 +1521,12 @@ class MatrixAdapter(BasePlatformAdapter):
     async def stop_typing(self, chat_id: str) -> None:
         await self._set_typing(chat_id, 0)
 
-    async def edit_message(self, chat_id: str, message_id: str, content: str, *, finalize: bool = False) -> SendResult:
+    async def edit_message(self, chat_id: str, message_id: str, content: str, *, finalize: bool = False,
+                           agent_status: Optional[Dict[str, Any]] = None) -> SendResult:
         formatted = self.format_message(content)
         new_content = self._build_text_message_content(formatted)
+        if agent_status:
+            new_content[_AGENT_STATUS_KEY] = agent_status
         msg_content: Dict[str, Any] = {"msgtype": "m.text", "body": f"* {formatted}", "m.new_content": new_content}
         if "m.mentions" in new_content:
             msg_content["m.mentions"] = new_content["m.mentions"]
@@ -1519,6 +1534,8 @@ class MatrixAdapter(BasePlatformAdapter):
             msg_content["format"] = "org.matrix.custom.html"
             msg_content["formatted_body"] = f'* {new_content["formatted_body"]}'
         msg_content["m.relates_to"] = {"rel_type": "m.replace", "event_id": message_id}
+        if agent_status:
+            msg_content[_AGENT_STATUS_KEY] = agent_status
         if _content_bytes(msg_content) > _MAX_CONTENT_BYTES:
             # The top-level copy is only the fallback for clients without edit support (edit-aware
             # clients render m.new_content); shorten it rather than double the event past the cap.
@@ -1727,6 +1744,11 @@ class MatrixAdapter(BasePlatformAdapter):
             f"{t('platform.matrix.approval.legend_intro')}\n" + "\n".join(t(self._EA_LEGEND_KEYS[c]) for c in choices))
         reactions = tuple(self._EA_REACTIONS[c] for c in choices)
         session_key, chat_id = prompt.session_key, prompt.chat_id
+        # Agent protocol: the same choices, labelled as the prompt's own actions are.
+        labels = {choice: label for label, choice, _style in prompt.actions}
+        agent_choices = [{"key": self._EA_REACTIONS[c], "label": labels.get(c) or c} for c in choices]
+        metadata = dict(prompt.metadata or {})
+        metadata["fluxchat_agent"] = {"v": 1, "state": "waiting", "choices": agent_choices}
 
         def _make(message_id, requester, expires_at):
             old_event = self._approval_prompt_by_session.get(session_key)
@@ -1735,9 +1757,9 @@ class MatrixAdapter(BasePlatformAdapter):
             self._approval_prompt_by_session[session_key] = message_id
             return _MatrixApprovalPrompt(
                 session_key=session_key, chat_id=chat_id, message_id=message_id, requester_user_id=requester,
-                expires_at=expires_at)
+                expires_at=expires_at, text=text, agent_choices=agent_choices)
         return await self._send_reaction_prompt(
-            chat_id, text, prompt.metadata, _make, self._approval_prompts_by_event, reactions, "approval")
+            chat_id, text, metadata, _make, self._approval_prompts_by_event, reactions, "approval")
 
     async def send_model_picker(
         self, chat_id: str, providers: list, current_model: str, current_provider: str, session_key: str,
@@ -2561,6 +2583,7 @@ class MatrixAdapter(BasePlatformAdapter):
                     "Matrix reaction resolved %d approval(s) for session %s (choice=%s, user=%s)",
                     count, prompt.session_key, choice, sender)
                 await self._redact_bot_approval_reactions(room_id, prompt)
+                await self._settle_agent_prompt(room_id, prompt)
         except Exception as exc:
             logger.error("Failed to resolve gateway approval from Matrix reaction: %s", exc)
         return True
@@ -2640,11 +2663,22 @@ class MatrixAdapter(BasePlatformAdapter):
         except Exception as exc:
             logger.debug("Matrix: failed to send invalid reaction feedback: %s", exc)
 
+    async def _settle_agent_prompt(self, room_id: str, prompt: Any) -> None:
+        """Agent protocol: edit a settled prompt out of "waiting" so clients drop its buttons."""
+        if not getattr(prompt, "agent_choices", None) or not getattr(prompt, "text", ""):
+            return
+        try:
+            await self.edit_message(room_id, prompt.message_id, prompt.text,
+                                    agent_status={"v": 1, "state": "working", "choices": prompt.agent_choices})
+        except Exception as exc:
+            logger.debug("Matrix: couldn't settle agent prompt %s: %s", prompt.message_id, exc)
+
     async def _expire_matrix_approval_prompt(self, room_id: str, target_event_id: str, prompt: Any) -> None:
         prompt.resolved = True
         self._approval_prompts_by_event.pop(target_event_id, None)
         self._approval_prompt_by_session.pop(prompt.session_key, None)
         await self._redact_bot_approval_reactions(room_id, prompt)
+        await self._settle_agent_prompt(room_id, prompt)
         await self._send_invalid_reaction_feedback(
             room_id, target_event_id,
             t("platform.matrix.approval.expired"))
diff --git a/tests/gateway/test_matrix_agent_protocol.py b/tests/gateway/test_matrix_agent_protocol.py
new file mode 100644
index 00000000..ac5265fb
--- /dev/null
+++ b/tests/gateway/test_matrix_agent_protocol.py
@@ -0,0 +1,71 @@
+"""Matrix adapter: fluxchat agent protocol fields (org.fluxchat.agent) on approvals."""
+import types
+
+import pytest
+from unittest.mock import AsyncMock, patch
+
+from gateway.config import PlatformConfig
+from gateway.platforms.base import ExecApprovalPrompt, SendResult
+
+KEY = "org.fluxchat.agent"
+
+
+def _adapter(monkeypatch):
+    monkeypatch.setenv("MATRIX_ALLOWED_USERS", "@me:example.org")
+    from plugins.platforms.matrix.adapter import MatrixAdapter
+    adapter = MatrixAdapter(PlatformConfig(enabled=True, token="tok", extra={"homeserver": "https://matrix.example.org"}))
+    adapter._user_id = "@bot:example.org"
+    adapter._client = object()
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_send_carries_agent_status_from_metadata(monkeypatch):
+    adapter = _adapter(monkeypatch)
+    sent = []
+    adapter._send_room_message = AsyncMock(side_effect=lambda chat, content: sent.append(content) or "$e1")
+    await adapter.send("!r:example.org", "hi", metadata={"fluxchat_agent": {"v": 1, "state": "working"}})
+    assert sent[0][KEY] == {"v": 1, "state": "working"}
+    # Without it, nothing extra.
+    await adapter.send("!r:example.org", "plain")
+    assert KEY not in sent[1]
+
+
+@pytest.mark.asyncio
+async def test_approval_prompt_offers_its_choices_then_settles(monkeypatch):
+    adapter = _adapter(monkeypatch)
+    sent = []
+    adapter._send_room_message = AsyncMock(side_effect=lambda chat, content: sent.append(content) or "$prompt")
+    adapter._send_reaction = AsyncMock(return_value="$r")
+    prompt = ExecApprovalPrompt(
+        chat_id="!r:example.org", session_key="sess-1", text="Run `rm -rf build`?",
+        actions=[("Allow once", "once", "primary"), ("Always allow", "always", ""), ("Deny", "deny", "danger")],
+        command="rm -rf build", description="", smart_denied=False, metadata={"thread_id": "$root"})
+    result = await adapter._send_exec_approval_prompt(prompt)
+    assert result.message_id == "$prompt"
+    status = sent[0][KEY]
+    assert status["state"] == "waiting"
+    assert [c["label"] for c in status["choices"]] == ["Allow once", "Always allow", "Deny"]
+    assert sent[0]["m.relates_to"]["event_id"] == "$root", "thread metadata still applies"
+
+    # The user approves: the prompt is edited out of "waiting".
+    adapter.edit_message = AsyncMock(return_value=SendResult(success=True))
+    adapter._redact_bot_approval_reactions = AsyncMock()
+    event = types.SimpleNamespace(sender="@me:example.org", event_id="$react", room_id="!r:example.org",
+                                  content={"m.relates_to": {"event_id": "$prompt", "key": "✅"}})
+    with patch("tools.approval.resolve_gateway_approval", return_value=1):
+        await adapter._on_reaction(event)
+    args, kwargs = adapter.edit_message.call_args
+    assert args[1] == "$prompt"
+    assert kwargs["agent_status"]["state"] == "working"
+    assert kwargs["agent_status"]["choices"] == status["choices"]
+
+
+@pytest.mark.asyncio
+async def test_edit_puts_status_in_new_content(monkeypatch):
+    adapter = _adapter(monkeypatch)
+    captured = []
+    adapter._send_content_event = AsyncMock(side_effect=lambda chat, content: captured.append(content) or SendResult(success=True))
+    await adapter.edit_message("!r:example.org", "$m", "Working on it", agent_status={"v": 1, "state": "done"})
+    assert captured[0]["m.new_content"][KEY] == {"v": 1, "state": "done"}
+    assert captured[0][KEY] == {"v": 1, "state": "done"}
